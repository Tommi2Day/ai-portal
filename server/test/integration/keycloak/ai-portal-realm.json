{
  "realm": "ai-portal",
  "displayName": "AI Portal integration test realm",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "groups": [
    {
      "name": "grp-pg"
    },
    {
      "name": "grp-other"
    },
    {
      "name": "grp-admin"
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "service-account-portal-it",
      "enabled": true,
      "serviceAccountClientId": "portal-it",
      "email": "portal-it@example.com",
      "emailVerified": true,
      "groups": [
        "/grp-pg"
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "service-account-portal-denied",
      "enabled": true,
      "serviceAccountClientId": "portal-denied",
      "email": "portal-denied@example.com",
      "emailVerified": true,
      "groups": [
        "/grp-other"
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "groups": [
        "/grp-pg"
      ]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "groups": [
        "/grp-other"
      ]
    },
    {
      "id": "55555555-5555-4555-8555-555555555555",
      "username": "root",
      "email": "root@example.com",
      "emailVerified": true,
      "firstName": "Root",
      "lastName": "Test",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "root",
          "temporary": false
        }
      ],
      "groups": [
        "/grp-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "portal-it",
      "name": "AI Portal integration tests: portal-it (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "portal-it-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-pg-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api://pg-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-ai-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api://ai-portal",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "portal-denied",
      "name": "AI Portal integration tests: portal-denied (client credentials)",
      "enabled": true,
      "publicClient": false,
      "secret": "portal-denied-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-pg-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api://pg-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "audience-ai-portal",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api://ai-portal",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ai-portal-web",
      "name": "AI Portal sign-in (authorization code + PKCE) for the integration tests",
      "enabled": true,
      "publicClient": false,
      "secret": "ai-portal-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}