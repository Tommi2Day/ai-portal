# --- Required ---
PUBLIC_URL=http://localhost:8080
# openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-chars
# openssl rand -base64 32
ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-123
# true when served over HTTPS
COOKIE_SECURE=false

# --- LDAP / Active Directory (optional) ---
LDAP_ENABLED=false
LDAP_URL=ldaps://dc01.example.local:636
LDAP_BIND_DN=CN=svc-aiportal,OU=Service,DC=example,DC=local
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=OU=Users,DC=example,DC=local
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_USER_GROUP_DN=CN=AI-Portal-Users,OU=Groups,DC=example,DC=local
LDAP_ADMIN_GROUP_DN=CN=AI-Portal-Admins,OU=Groups,DC=example,DC=local

# --- OIDC / Azure AD (Entra ID) (optional) ---
OIDC_ENABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Microsoft
OIDC_ROLE_CLAIM=roles
OIDC_USER_VALUE=AiPortal.User
OIDC_ADMIN_VALUE=AiPortal.Admin

# only needed if user entries have no memberOf
LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=example,DC=local
OIDC_GROUP_CLAIM=groups

# --- Knowledge base ---
KNOWLEDGE_ENABLED=true
# run the sync scheduler in this process
KNOWLEDGE_WORKER=true
# mount root for file-share sources
KNOWLEDGE_FS_ROOT=/data/shares
KNOWLEDGE_MAX_FILE_MB=50

# --- Branding (optional) ---
# Name in the top bar, on the sign-in page and in the browser tab
# PORTAL_NAME=AI Portal
# Stylesheet overriding the color variables, and a logo file (svg/png/jpg/gif/webp) or http(s) URL.
# Paths inside the container, see docker-compose.yml for the /branding mount.
# BRANDING_DIR=./examples/branding
# PORTAL_THEME_CSS=/branding/theme.css
# PORTAL_LOGO=/branding/logo.svg

# --- AWS Bedrock with an IAM role (optional, see docs/llm-providers.md) ---
# Credentials come from the AWS default chain (EKS Pod Identity, IRSA, instance profile or AWS_* variables)
# BEDROCK_TOKEN_TTL_SECONDS=3600
# Model list from the account: only these inference profiles, e.g. EU only
# BEDROCK_INFERENCE_PROFILE_PREFIXES=eu.

# --- Outgoing proxy / CA (optional, see docs/llm-providers.md) ---
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://proxy.acme.local:3128
# NO_PROXY=localhost,db,.acme.local
# NODE_EXTRA_CA_CERTS=/etc/ssl/custom/ca.pem

# --- Other ---
UPLOAD_MAX_MB=20
MAX_TOOL_STEPS=8
AUDIT_LOG_PROMPTS=false
MCP_ALLOW_PRIVATE_NETWORKS=true
LOG_LEVEL=info
